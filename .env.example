# Environment variables for Systemly

# Base URL for production deployment
# Used for canonical tags, sitemap, robots.txt, Open Graph, and PWA manifest
# REQUIRED for production - must be set to your actual domain
# Default (if not set): http://localhost:3001
NEXT_PUBLIC_BASE_URL=https://systemly.app

# Optional: Analytics or tracking
# NEXT_PUBLIC_ANALYTICS_ID=

# Optional: API endpoints
# NEXT_PUBLIC_API_URL=https://api.systemly.app
